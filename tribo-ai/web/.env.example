# Tribo.ai environment variables

# ----- Core -----
DATABASE_URL="postgresql://user:password@localhost:5432/tribo_ai"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ----- IA -----
ANTHROPIC_API_KEY=""

# ----- Mensageria -----
RESEND_API_KEY=""
WHATSAPP_API_TOKEN=""  # 360dialog ou Meta
WHATSAPP_PHONE_ID=""

# ----- Pagamento -----
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# ou Asaas
ASAAS_API_KEY=""

# ----- Storage -----
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ----- Observabilidade -----
SENTRY_DSN=""
POSTHOG_KEY=""

# ----- Agentes operacionais -----
FOUNDER_WHATSAPP=""   # para escalations P0/P1
FOUNDER_EMAIL=""      # fallback

# ----- Enriquecimento de leads -----
RECEITA_WS_TOKEN=""
APOLLO_API_KEY=""
